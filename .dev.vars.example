# Copy this file to .dev.vars and paste your Meta Model API key.
# .dev.vars is gitignored. Never commit a real key.
MODEL_API_KEY=paste-your-meta-model-api-key-here

# Optional. muse-spark-1.2 (default) or muse-spark-1.2-contributor (cheaper; Meta may train on prompts).
MODEL_ID=muse-spark-1.2-contributor
