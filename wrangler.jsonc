// Cloudflare Worker config. Workers Builds runs `npm run build` then `npx wrangler deploy` on every
// push to main. The key is a secret set in the dashboard (MODEL_API_KEY), never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipodojo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Only the API runs code; the game itself is plain files.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Today's leaderboard (functions/api/leaderboard.js): daily star totals per country, and
  // one-time receipts for real answers. No personal data. The tables are made on first use.
  "d1_databases": [
    { "binding": "DB", "database_name": "pipodojo-leaderboard", "database_id": "bcb2faf7-0684-4710-951e-e8651141be2c" }
  ],
  // Deploys keep any variables set in the dashboard instead of wiping them (secrets always stay).
  "keep_vars": true
}
